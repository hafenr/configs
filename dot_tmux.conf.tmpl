set-option -g default-shell $SHELL

# tmux is supposed to figure out 256-color support from terminfo and set this,
# but it seems to fail anyway.
set -g default-terminal "screen-256color"

# Claude Code recommended
set -g allow-passthrough on
set -g focus-events on

# Required for Shift+Enter and other modified keys
set -g extended-keys always
set -g extended-keys-format csi-u
set -as terminal-features 'ghostty*:extkeys'

# Automatically set window title
set-window-option -g automatic-rename on
set -g automatic-rename-format '#{s/^feature-//:#{b:pane_current_path}}'
set-option -g set-titles on

# ctrl-p/n for command history
set-option -g status-keys emacs
set -g history-limit 10000
set -g escape-time 0

# prefix key
{{ if eq .chezmoi.os "linux" -}}
set -g prefix C-b
{{- else -}}
unbind C-b
set -g prefix C-o
{{- end }}

# set -g utf-8 on
# set -g status-utf-8 on
set-option -g history-limit 100000

set -g base-index 1
set -g renumber-windows on

# disable wait after escape, so vim is usable

# set -sg escape-time 0
set-option -sg escape-time 0


# bind-key -r "<" swap-window -t -1
# bind-key -r ">" swap-window -t +1
bind-key -r "<" swap-pane -t -1
bind-key -r ">" swap-pane -t +1

# the panes display and status messages don't show very long by default
set -g display-panes-time 4000
set -g display-time 4000

# ## window
setw -g aggressive-resize on

# enable mouse and scrolling with wheel
set -g mouse on
bind -n WheelUpPane if-shell -F -t = "#{mouse_any_flag}" "send-keys -M" "if -Ft= '#{pane_in_mode}' 'send-keys -M' 'copy-mode -e'"

setw -g mode-keys vi
setw -g monitor-activity on

# Reload settings
bind-key r source-file ~/.tmux.conf

# Temp maximize window
bind C-p resize-pane -Z

# Set CWD to dir of current window
bind '"' split-window -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"

# C-o C-k as alias for C-o C-:
bind C-k command-prompt

# Press the prefix twice to send it through to the application (e.g. nested tmux)
{{ if eq .chezmoi.os "linux" -}}
bind C-b send-prefix
{{- else -}}
bind C-o send-prefix
{{- end }}

# Alt-[hjkl]
bind -n M-J resize-pane -D 2
bind -n M-K resize-pane -U 2
bind -n M-H resize-pane -L 2
bind -n M-L resize-pane -R 2

# Alt arrow keys (resizing lives on M-S-hjkl)
bind -n M-left previous-window
bind -n M-right next-window

# Use Alt-vim keys without prefix key to switch panes
bind -n M-h select-pane -L
bind -n M-j select-pane -D
bind -n M-k select-pane -U
bind -n M-l select-pane -R

# Alt-number to switch windows, continuing on Alt-Shift-number for 11-20.
# Past window 20 there is no key; prefix-' prompts for an index.
# A terminal encodes Alt-Shift-<digit> either as the extended key or as the
# shifted character, and tmux treats those as distinct keys, so bind both.
bind -n M-1 select-window -t 1
bind -n M-2 select-window -t 2
bind -n M-3 select-window -t 3
bind -n M-4 select-window -t 4
bind -n M-5 select-window -t 5
bind -n M-6 select-window -t 6
bind -n M-7 select-window -t 7
bind -n M-8 select-window -t 8
bind -n M-9 select-window -t 9
bind -n M-0 select-window -t 10

bind -n M-S-1 select-window -t 11
bind -n 'M-!' select-window -t 11
bind -n M-S-2 select-window -t 12
bind -n 'M-@' select-window -t 12
bind -n M-S-3 select-window -t 13
bind -n 'M-#' select-window -t 13
bind -n M-S-4 select-window -t 14
bind -n 'M-$' select-window -t 14
bind -n M-S-5 select-window -t 15
bind -n 'M-%' select-window -t 15
bind -n M-S-6 select-window -t 16
bind -n 'M-^' select-window -t 16
bind -n M-S-7 select-window -t 17
bind -n 'M-&' select-window -t 17
bind -n M-S-8 select-window -t 18
bind -n 'M-*' select-window -t 18
bind -n M-S-9 select-window -t 19
bind -n 'M-(' select-window -t 19
bind -n M-S-0 select-window -t 20
bind -n 'M-)' select-window -t 20

# Shift arrow to switch windows
bind -n S-Left  previous-window
bind -n S-Right next-window

bind -n C-S-Left  swap-window -t -1 \; select-window -t -1
bind -n C-S-Right swap-window -t +1 \; select-window -t +1

# Move the current window left/right with ctrl+alt+shift+h/l. tmux treats
# C-M-S-h and C-M-H as two distinct keys and which one arrives depends on the
# terminal's extended-key encoding, so bind both spellings.
bind -n C-M-S-h swap-window -t -1 \; select-window -t -1
bind -n C-M-H   swap-window -t -1 \; select-window -t -1
bind -n C-M-S-l swap-window -t +1 \; select-window -t +1
bind -n C-M-L   swap-window -t +1 \; select-window -t +1

# Reload tmux config
bind r source-file ~/.tmux.conf

# THEME
set -g status-justify centre
set -g status-style bg=colour235,fg=white
# Defaults to reverse, which paints a light block behind every window that has
# unseen output - which is all of them.
set -g window-status-activity-style default
# Cap window names so the tabs fit on a status line; the trailing space in
# each format is the separator, so window-status-separator must be empty.
set -g window-status-separator ''
# Label each tab with the key that selects it instead of the raw index;
# windows past 20 have no key and fall back to the index.
{{ if eq .chezmoi.os "linux" -}}
%hidden MOD="A-"
%hidden MOD_SHIFT="A-S-"
{{- else -}}
%hidden MOD="⌥"
%hidden MOD_SHIFT="⌥⇧"
{{- end }}
%hidden WIN_KEY="#{?#{e|<=:#{window_index},20},#{?#{e|>:#{window_index},10},${MOD_SHIFT},${MOD}}#{e|m:#{window_index},10},#{window_index}}"
set -g window-status-format "#[fg=colour148,bold][${WIN_KEY}]#[default] #{=/12/…:window_name} "
set -g window-status-current-format "#[fg=colour235,bg=colour148,bold][${WIN_KEY}]#[fg=colour255,bg=colour238,bold] #{=/12/…:window_name} #[default]"
set -g status-interval 5
set -g status-left-length 30
set -g status-left '#[fg=colour148][#S]'

# Spread the window tabs over two status rows, one per block of keys: the ⌥
# windows 1-10 on the first, ⌥⇧ windows 11 and up on the second. tmux never
# wraps the window list, so each row renders the list filtered to its range.
%hidden ROW0="#{e|<=:#{window_index},10}"
%hidden ROW1="#{e|>:#{window_index},10}"
%hidden TAB="#[range=window|#{window_index} #{E:window-status-style}]#[push-default]#{T:window-status-format}#[pop-default]#[norange default]"
%hidden TAB_CURRENT="#[range=window|#{window_index} list=focus #{E:window-status-current-style}]#[push-default]#{T:window-status-current-format}#[pop-default]#[norange list=on default]"
%hidden TABS_START="#[list=on align=#{status-justify}]#[list=left-marker]<#[list=right-marker]>#[list=on]"
set -g status 2
set -g status-format[0] "#[align=left range=left #{E:status-left-style}]#[push-default]#{T;=/#{status-left-length}:status-left}#[pop-default]#[norange default]${TABS_START}#{W:#{?${ROW0},${TAB},},#{?${ROW0},${TAB_CURRENT},}}#[nolist align=right range=right #{E:status-right-style}]#[push-default]#{T;=/#{status-right-length}:status-right}#[pop-default]#[norange default]"
set -g status-format[1] "${TABS_START}#{W:#{?${ROW1},${TAB},},#{?${ROW1},${TAB_CURRENT},}}#[nolist]"

# stop annoying beeps
set -g bell-action none
set -g visual-bell off

# copying
unbind [
bind [ copy-mode
unbind p
{{ if eq .chezmoi.os "darwin" -}}
bind y run "tmux save-buffer - | reattach-to-user-namespace pbcopy"
bind-key p run "pbpaste -o | tmux load-buffer - ; tmux paste-buffer"
{{ else -}}
bind y run "tmux save-buffer - | xclip -selection clipboard -i"
bind-key p run "xclip -selection clipboard -o | tmux load-buffer - ; tmux paste-buffer"
{{ end -}}

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-copycat'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

# Plugin options
set -g @continuum-restore 'on'

set -g status-right '#(if [[ "#{pane_current_path}" == *"alt-delta"* ]]; then echo "#[bg=colour196,fg=colour255,bold] ALT-DELTA #[default]"; fi)'

# Initializes TMUX plugin manager.
# Keep this line at the very bottom of tmux.conf.
run '~/.tmux/plugins/tpm/tpm'
